# =============================================================
# CP-Agent configuration
# Copy this file to `.env` and fill in your own values.
# =============================================================

# --- Codeforces ---
CODEFORCES_HANDLE=tourist
CODEFORCES_API_BASE=https://codeforces.com/api

# --- LeetCode (future support, currently a stub service) ---
LEETCODE_USERNAME=
LEETCODE_ENABLED=false
LEETCODE_SESSION=session_id will change always, so you need to get it from your browser's cookies. See README for instructions.

# --- GitHub ---
# Personal access token with "repo" scope: https://github.com/settings/tokens
GITHUB_TOKEN=ghp_your_token_here
GITHUB_USERNAME=your-github-username
GITHUB_REPO_NAME=competitive-programming

# --- Gemini (used by the Documentation Agent) ---
# Leave blank to fall back to the built-in offline template generator.
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# --- Local paths ---
# Folder VS Code / your editor saves solution files into. CP-Agent watches this.
LOCAL_SOLUTIONS_DIR=./solutions
# Local path of the git-managed portfolio repository CP-Agent commits/pushes to.
REPO_PATH=./repo
DATABASE_PATH=./memory/solved.db
PROMPTS_DIR=./prompts
LOGS_DIR=./logs

# --- Agent behaviour ---
# How often (seconds) to poll Codeforces/LeetCode for new accepted verdicts.
POLL_INTERVAL_SECONDS=60
MAX_RETRIES=3
RETRY_BACKOFF_SECONDS=2.0
# If true, the pipeline runs end-to-end but skips git commit/push and GitHub calls.
DRY_RUN=false
AUTO_PUSH=true